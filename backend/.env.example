# App
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
# Option A — a single connection string (what Render/Railway/Heroku-style
# hosts inject automatically). Takes priority over the DB_* vars below
# when set — see src/database/database.module.ts and data-source.ts.
DATABASE_URL=
# Option B — discrete vars, used for local development.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=manpower_mgmt
DB_SSL=false
# Only ever set true in local dev. Production must use migrations.
DB_SYNCHRONIZE=false

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# File storage (AWS S3 or Cloudflare R2 — R2 is cheaper and S3-compatible)
STORAGE_PROVIDER=r2
STORAGE_BUCKET=manpower-mgmt-uploads
STORAGE_REGION=auto
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# OpenAI (OCR / document extraction / letter generation / HR assistant)
OPENAI_API_KEY=

# Seed data (first Super Admin account created by `npm run seed`)
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
SEED_SUPER_ADMIN_NAME=Super Admin
