# Copy to .env and fill in before running `docker compose up -d --build`.
# This file configures docker-compose.yml (Postgres + backend + frontend).

# --- Database ---
DB_USERNAME=postgres
DB_PASSWORD=change-me-strong-password
DB_NAME=manpower_mgmt

# --- Backend / API ---
# Generate strong random secrets, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CORS_ORIGIN=http://localhost:3000

# First Super Admin account created automatically on first boot.
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=change-me-strong-password
SEED_SUPER_ADMIN_NAME=Super Admin

# --- File storage (Cloudflare R2 recommended — S3-compatible, no egress fees) ---
STORAGE_PROVIDER=r2
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# --- OpenAI (OCR / document extraction / HR assistant) ---
OPENAI_API_KEY=

# --- Frontend ---
# Must be reachable from the BROWSER, not just the server — use your real
# domain in production, e.g. https://api.yourapp.com/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api
